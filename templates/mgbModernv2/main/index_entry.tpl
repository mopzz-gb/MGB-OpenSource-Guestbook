<article class="entry" id="e{ENTRY_ID}">

	<header class="entry-header">
		<div class="entry-left">
			<span class="entry-id">#{ENTRY_ID}</span>

			<h3 class="entry-author">
				{ENTRY_ANCHOR}
				{ENTRY_NAME}
				{TEMPLATE_ENTRY_CITY}
			</h3>
		</div>

		<time class="entry-date">
			{ENTRY_TIMESTAMP}
		</time>
	</header>

	<section class="entry-message">
		{TEMPLATE_ENTRY_MESSAGE}
	</section>

	<footer class="entry-footer">
		<div class="entry-info">
			{TEMPLATE_ENTRY_INFO}
		</div>

		<div class="entry-comment">
			{TEMPLATE_ENTRY_COMMENT}
		</div>
	</footer>

</article>