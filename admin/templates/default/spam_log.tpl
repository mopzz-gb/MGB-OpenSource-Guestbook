<table summary="entry" class="entry" cellspacing="0" cellpadding="3">
	<tr>
		<td class="entry_id"><span><b>{ENTRY_ID}</b></span></td>
		<td class="entry_name"><span><b>{ENTRY_NAME}</b></span></td>
		<td class="entry_message"><span>{ENTRY_MESSAGE}</span></td>
		<td class="entry_timestamp"><span>{ENTRY_TIMESTAMP}</span></td>
		<td class="entry_icons">{DELETE}<!-- <br>{ENTRY_COUNTRY} --></td>
	</tr>
	<tr>
		<td class="entry_ip" colspan="2"><span><b>{ENTRY_IP}{ENTRY_REPORT_SPAM}</b></span></td>
		<td class="entry_message" colspan="2"><span><b>{ENTRY_EMAIL}<br>{ENTRY_HP}</b></span></td>
	</tr>
	<tr>
		<td class="entry_site"><span><b>{ENTRY_SITE}</b></span></td>
		<td colspan="4" class="entry_type"><span><b>{ENTRY_TYPE}</b></span></td>
	</tr>	
	<tr>
		<td colspan="4" class="entry_user_agent"><span><b>User Agent:</b> {ENTRY_USER_AGENT}</span></td>
	</tr>
	<tr>
		<td colspan="4" class="entry_user_agent"><span><b>Referer:</b> {ENTRY_HTTP_REFERER}</span></td>
	</tr>
</table>